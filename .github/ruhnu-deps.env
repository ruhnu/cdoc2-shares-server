# Git refs of ruhnu sibling repos built by .github/workflows/ruhnu-images.yml
# before the shares server. Their artifacts are not published to any Maven
# repo CI can reach, so they are built and installed into the local Maven repo.
#
# The refs must produce the versions this branch's poms depend on
# (cdoc2-auth-token, cdoc2-key-shares-openapi). On a feature branch, point them
# at the matching sibling feature branches.
CDOC2_OPENAPI_REF=feat/add-did-recipient
CDOC2_AUTH_REF=feat/add-did-recipient
